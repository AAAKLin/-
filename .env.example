# 复制为 .env 后按需修改（.env 不会被提交到 git，密钥放这里最安全）
# 复制方法：copy .env.example .env

# ---------- 服务监听 ----------
# 服务监听端口
PORT=3100
# 监听地址：
#   127.0.0.1 = 只有本机电脑能访问（默认，最安全）
#   0.0.0.0   = 同一 WiFi 下的手机/平板也能访问（方便手机用，但同网任何人都能打开，无密码）
#               ↑ 建议只在家里等可信网络下临时开启，用完改回 127.0.0.1
HOST=127.0.0.1
# 运行环境：development / test / production
NODE_ENV=development
# 数据目录（SQLite 数据库与 WAL 文件存放位置）
DATA_DIR=./data
# 日志级别：debug / info / warn / error / silent
LOG_LEVEL=info

# ============================================================
# AI 接口密钥（可选）——没配密钥时所有功能照常可用，
# 「今日行动中心」的 AI 建议会自动降级为规则建议
# ============================================================
# 当前使用智谱 GLM（OpenAI 兼容协议，glm-4.7-flash 长期免费）。
# 申请地址：https://open.bigmodel.cn/ （注册后在"个人中心-API keys"创建）
#
# 三种配置方式任选其一，优先级从上到下：
#
# 【方式 1】直接写密钥（最省事，但容易误提交，不推荐）
# AI_API_KEY=你的密钥
#
# 【方式 2】密钥写在一个文件里，这里填文件路径（推荐）
# AI_API_KEY_FILE=C:/Users/你的用户名/secrets/ai_key.txt
#
# 【方式 3】你已经把"密钥文件路径"存进了系统环境变量时，用这个（推荐）
# 只需填"环境变量的名字"，程序会去读这个变量的值，再把值当成文件路径去读密钥
# AI_API_KEY_FILE_ENV=MY_AI_KEY_PATH
#
# 配置完成后，启动服务访问 http://127.0.0.1:3100/api/settings/ai-status
# 可以看到 configured: true 和脱敏片段（前2后2位），用来确认加载的是不是正确的钥匙。
# 密钥原文不会出现在日志、接口返回和前端代码里。

# ---------- AI 服务参数（一般不用改） ----------
# 模型名（智谱免费模型，可在其控制台确认最新型号）
# AI_MODEL=glm-4.7-flash
# OpenAI 兼容端点（智谱默认，换服务商才需要改）
# AI_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# 请求超时（毫秒）与最大输出长度
# AI_TIMEOUT_MS=30000
# AI_MAX_TOKENS=600
